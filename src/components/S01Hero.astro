        <g class="w-static">
          {decor.map((pts, i) => <path class="w" d={route(pts)} pathLength="1" style={`--i:${i + 2}`} />)}
          {wires.map((w, i) => <path class="w" d={w.d} pathLength="1" style={`--i:${i}`} />)}
          <path class="w" d={feed} pathLength="1" style="--i:5" />
          {ends.map(([x, y]) => <circle class="w-end" cx={x} cy={y} r="3.5" />)}
        </g>
        <g class="w-pulses">
          {wires.map((w) => (
            <g class="pz" data-src={w.name} style={`--o0:${w.o0.toFixed(0)};--o1:${w.o1.toFixed(0)};--d:${CYCLE}s;--s:${w.start.toFixed(2)}s`}>
              <path class="p-halo" d={w.d} />
