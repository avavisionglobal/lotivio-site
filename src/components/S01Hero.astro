---
import Btn from './ui/Btn.astro';
// S01 · Hero (réf. Synais, captures fournies par Diego le 11.11.2026), version 4 « téléphone » (test du 12.11.2026) :
// titre court en deux tons, une main qui tient un téléphone ouvert sur Lotivio, cinq canaux posés sur des fils fins.
// Une impulsion à la fois part d'un canal, arrive dans le téléphone : la demande s'ajoute à l'écran
// et la carte « Demandes reçues » monte.
// Photo : Higgsfield Soul 2.0 (job 13c081fd…), détourée (job 88f5f37f…), écran vierge ; l'interface est en HTML.
// Sources de la photo : assets/hero/2026-11-12-telephone-soul2/. Version précédente (objet carré) : proofs/archive/S01Hero-v3-boitier.astro.
import '../styles/hero-circuit.css';

/* ---------- Géométrie : scène de 1920 × 960, cadre utile de 1440 px à partir de x = 240 ---------- */
type P = [number, number];
function route(pts: P[], r = 14) {
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const [px, py] = pts[i - 1], [cx, cy] = pts[i], [nx, ny] = pts[i + 1];
    const l1 = Math.hypot(cx - px, cy - py), l2 = Math.hypot(nx - cx, ny - cy);
    const k = Math.min(r, l1 / 2, l2 / 2);
    const ax = cx - ((cx - px) / l1) * k, ay = cy - ((cy - py) / l1) * k;
    const bx = cx + ((nx - cx) / l2) * k, by = cy + ((ny - cy) / l2) * k;
    d += ` L${ax.toFixed(1)} ${ay.toFixed(1)} Q${cx} ${cy} ${bx.toFixed(1)} ${by.toFixed(1)}`;
  }
  const [lx, ly] = pts[pts.length - 1];
  return d + ` L${lx} ${ly}`;
}
const length = (pts: P[]) => pts.slice(1).reduce((s, p, i) => s + Math.hypot(p[0] - pts[i][0], p[1] - pts[i][1]), 0);
function along(pts: P[], q: P) {
  let best = Infinity, at = 0, acc = 0;
  for (let i = 1; i < pts.length; i++) {
    const [ax, ay] = pts[i - 1], [bx, by] = pts[i];
    const L = Math.hypot(bx - ax, by - ay);
    const t = Math.max(0, Math.min(1, ((q[0] - ax) * (bx - ax) + (q[1] - ay) * (by - ay)) / (L * L || 1)));
    const dd = Math.hypot(ax + (bx - ax) * t - q[0], ay + (by - ay) * t - q[1]);
    if (dd < best) { best = dd; at = acc + L * t; }
    acc += L;
  }
  return at;
}

const PHONE_X = 720, PHONE_TOP = 615; // axe et haut du téléphone, en coordonnées de scène (les fils finissent derrière lui)
const SPEED = 300, DASH = 46, CYCLE = 12, STEP = CYCLE / 5; // une arrivée toutes les 2,4 s

type Src = { name: string; icon: string; pts: P[]; tile: P; tileM: P | null };
const sources: Src[] = [
  { name: 'Homegate', icon: 'homegate', pts: [[-260, 450], [260, 450], [260, 690], [720, 690]], tile: [260, 570], tileM: [478, 690] },
  { name: 'WhatsApp', icon: 'whatsapp', pts: [[1700, 470], [1170, 470], [1170, 705], [720, 705]], tile: [1170, 588], tileM: [962, 705] },
  { name: 'Meta Ads', icon: 'meta', pts: [[-260, 610], [110, 610], [110, 750], [720, 750]], tile: [400, 750], tileM: [455, 750] },
  { name: 'immobilier.ch', icon: 'immo', pts: [[1700, 640], [1340, 640], [1340, 765], [720, 765]], tile: [1030, 765], tileM: [985, 765] },
  { name: 'Votre site', icon: 'site', pts: [[-260, 820], [500, 820], [500, 800], [720, 800]], tile: [300, 820], tileM: null },
];
const wires = sources.map((s, i) => {
  const L = length(s.pts), o1 = -(L + 8), o0 = o1 + CYCLE * SPEED, start = -i * STEP - 0.4;
  const flash = (q: P | null) => (q ? start + (o0 - DASH + along(s.pts, q)) / SPEED : 0);
  return { ...s, d: route(s.pts), o0, o1, start, dl: flash(s.tile), dlm: flash(s.tileM) };
});
const decor: P[][] = [
  [[-260, 300], [70, 300], [70, 382]],
  [[1700, 320], [1300, 320], [1300, 404]],
  [[1700, 830], [1470, 830], [1470, 980]],
];
const ends: P[] = [[70, 382], [1300, 404]];
const feed = route([[720, 840], [945, 840], [945, 880]]);
const tools: { at: P; g: string; v?: boolean }[] = [
  { at: [110, 680], g: 'dots', v: true },
  { at: [1340, 702], g: 'bars', v: true },
  { at: [70, 340], g: 'grid', v: true },
  { at: [1470, 900], g: 'dots', v: true },
];
const px = (x: number) => x + 240;

// Photo : recadrage de 1160 × 1968 px ; axe du téléphone à x = 779, haut du téléphone à y = 16.
// L'écran (verre) occupe x 527 → 1033, y 32 → 1072 : l'interface HTML s'y pose en pourcentages.
const IMG_W = 500, k = IMG_W / 1160;
const img = { w: IMG_W, h: Math.round(1968 * k), left: px(PHONE_X) - Math.round(779 * k), top: PHONE_TOP - Math.round(16 * k) };

// Écran du téléphone : demandes de démonstration (personnes et lots fictifs).
const leads = [
  { src: 'Meta Ads', name: 'Camille Rochat', lot: 'Les Terrasses · Lot B4', t: '6 min' },
  { src: 'Homegate', name: 'Luca Bernasconi', lot: 'Clos des Vergers · Lot A2', t: '18 min' },
  { src: 'Votre site', name: 'Inès Moreau', lot: 'Les Terrasses · Lot C1', t: '42 min' },
  { src: 'immobilier.ch', name: 'Julien Favre', lot: 'Clos des Vergers · Lot A5', t: '1 h' },
  { src: 'WhatsApp', name: 'Sophie Girard', lot: 'Les Terrasses · Lot B2', t: '2 h' },
];
const srcIcon = (n: string) => ICON[sources.find((s) => s.name === n)!.icon];

// Carte « Demandes reçues » : 38 cette semaine (lun. → jeu.), le jour en cours monte à chaque arrivée.
const week = [{ d: 'L', v: 8 }, { d: 'M', v: 11 }, { d: 'M', v: 9 }, { d: 'J', v: 10, today: true }, { d: 'V' }, { d: 'S' }, { d: 'D' }];
const BAR_MAX = 20;
// Carte « Stock » : 12 lots, 5 vendus (s), 3 réservés (r), 4 libres (f).
const lots = 'ssrfsrsffrsf'.split('').map((s, i) => ({ s, id: `${'AB'[Math.floor(i / 6)]}${(i % 6) + 1}` }));

const ICON: Record<string, string> = {
  homegate: '<span class="ic-hg" style="background-image:url(/media/logos/homegate.svg)"></span>',
  meta: '<span class="ic-meta" style="background-image:url(/media/logos/meta-64.webp)"></span>',
  immo: '<img src="/media/logos/immobilier-ch-96.webp" alt="" width="20" height="20" />',
  whatsapp: '<img src="/media/logos/whatsapp.svg" alt="" width="20" height="20" />',
  site: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.8 3 2.8 15 0 18M12 3c-2.8 3-2.8 15 0 18"/></svg>',
};
---
<!-- S01 · Hero -->
<header class="hc" id="top">
  <div class="hc-head">
    <p class="hc-kick" data-bloc="S01.1">Développé pour la <span class="ch" aria-hidden="true"><svg viewBox="0 0 32 32"><rect width="32" height="32" rx="6" fill="#E2231A"/><path d="M13 7h6v6h6v6h-6v6h-6v-6H7v-6h6z" fill="#fff"/></svg></span> Suisse</p>
    <h1 data-bloc="S01.2">
      <span class="ln"><span class="hw"><span class="hwi" style="--i:0">Jusqu’à</span></span> <span class="hw"><span class="hwi" style="--i:1">5&nbsp;heures</span></span> <span class="hw"><span class="hwi" style="--i:2">gagnées</span></span> <span class="hw"><span class="hwi" style="--i:3">par</span></span> <span class="hw"><span class="hwi" style="--i:4">semaine.</span></span></span>
      <span class="ln tn"><span class="hw"><span class="hwi" style="--i:5">Plus</span></span> <span class="hw"><span class="hwi" style="--i:6">de</span></span> <span class="hw"><span class="hwi" style="--i:7">temps</span></span> <span class="hw"><span class="hwi" style="--i:8">pour</span></span> <span class="hw"><span class="hwi" style="--i:9">vendre</span></span> <span class="hw"><span class="hwi" style="--i:10">vos</span></span> <span class="hw"><span class="hwi" style="--i:11">biens<i class="o">.</i></span></span></span>
    </h1>
    <p class="sub" data-bloc="S01.3">Centralisez vos demandes, simplifiez la qualification de vos prospects et sachez qui relancer. Identifiez les canaux qui vous apportent des acheteurs et gérez la diffusion de vos biens au même endroit.</p>
    <div class="row-b" data-bloc="S01.4">
      <Btn label="Réserver une démo" href="#demo" />
      <Btn label="Voir le film · 1 min" tone="light" data-film />
    </div>
  </div>

  <div class="hc-stage">
    <div class="hc-scene" data-bloc="S01.5">
      <svg class="hc-wires" viewBox="-240 0 1920 960" width="1920" height="960" fill="none" aria-hidden="true">
        <g class="w-static">
          {decor.map((pts, i) => <path class="w" d={route(pts)} pathLength="1" style={`--i:${i + 2}`} />)}
          {wires.map((w, i) => <path class="w" d={w.d} pathLength="1" style={`--i:${i}`} />)}
          <path class="w" d={feed} pathLength="1" style="--i:5" />
          {ends.map(([x, y]) => <circle class="w-end" cx={x} cy={y} r="3.5" />)}
        </g>
        <g class="w-pulses">
          {wires.map((w) => (
            <g class="pz" data-src={w.name} style={`--o0:${w.o0.toFixed(0)};--o1:${w.o1.toFixed(0)};--d:${CYCLE}s;--s:${w.start.toFixed(2)}s`}>
              <path class="p-halo" d={w.d} />
              <path class="p-core" d={w.d} />
            </g>
          ))}
          <path class="p-feed" id="p-feed" d={feed} pathLength="100" />
        </g>
      </svg>

      {tools.map((t) => (
        <span class={`tool-c g-${t.g}${t.v ? ' v' : ''}`} style={`left:${px(t.at[0])}px;top:${t.at[1]}px`} aria-hidden="true"><i></i><i></i><i></i></span>
      ))}
      {wires.map((w) => (
        <span class={`src-t${w.tileM ? '' : ' d-only'}`} title={w.name} aria-hidden="true"
          style={`--x:${px(w.tile[0])}px;--y:${w.tile[1]}px;--xm:${px((w.tileM ?? w.tile)[0])}px;--ym:${(w.tileM ?? w.tile)[1]}px;--d:${CYCLE}s;--dl:${w.dl.toFixed(2)}s;--dlm:${w.dlm.toFixed(2)}s`}
          set:html={ICON[w.icon]} />
      ))}
      <span class="tile-c" style={`left:${px(1300)}px;top:362px`} aria-hidden="true"><img src="/brand/lotivio-mark.svg" alt="" width="22" height="22" /></span>

      <div class="hand" id="hand" style={`left:${img.left}px;top:${img.top}px;width:${img.w}px;height:${img.h}px`}>
        <div class="hand-in">
          <img src="/media/hero/main-telephone-960.webp" srcset="/media/hero/main-telephone-480.webp 480w, /media/hero/main-telephone-640.webp 640w, /media/hero/main-telephone-960.webp 960w" sizes="(max-width: 639px) 310px, (max-width: 1000px) 390px, 500px"
            width="960" height="1629" alt="Une main tient un téléphone ouvert sur Lotivio : les demandes des canaux de l'agence y arrivent" fetchpriority="high" decoding="async" />
          <div class="ph" aria-hidden="true">
            <div class="ph-status"><span>9:41</span><i class="ph-island"></i><span class="ph-sig"><svg width="11" height="7" viewBox="0 0 11 7"><rect x="0" y="4.5" width="2" height="2.5" rx=".5"/><rect x="3" y="3" width="2" height="4" rx=".5"/><rect x="6" y="1.5" width="2" height="5.5" rx=".5"/><rect x="9" y="0" width="2" height="7" rx=".5"/></svg><svg width="15" height="7" viewBox="0 0 15 7"><rect x=".5" y=".5" width="12" height="6" rx="1.6" fill="none" stroke="currentColor" opacity=".45"/><rect x="2" y="2" width="8" height="3" rx=".8"/><rect x="13.4" y="2.3" width="1.1" height="2.4" rx=".5" opacity=".45"/></svg></span></div>
            <div class="ph-bar"><span class="ph-brand"><img src="/brand/lotivio-mark.svg" alt="" width="13" height="13" />Lotivio</span><span class="ph-av">SK</span></div>
            <p class="ph-kick">Votre journée</p>
            <p class="ph-h">Bonjour Sarah,<br /><span class="ph-hn"><b id="ph-n">5</b> nouvelles demandes.</span></p>
            <p class="ph-sec"><b>Demandes reçues</b><span>Tout voir</span></p>
            <ul class="ph-list" id="ph-list">
              {leads.map((l) => (
                <li><span class="ph-src" set:html={srcIcon(l.src)} /><span class="ph-who"><b>{l.name}</b><span>{l.lot}</span></span><time>{l.t}</time></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="hc-foot">
    <div class="hc-info" data-bloc="S01.6">
      <span class="mono"><svg width="11" height="11" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M2 12h20M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>/mise en place/</span>
      <p>Nous installons et configurons Lotivio <span>selon votre façon de travailler.</span></p>
    </div>

    <div class="hc-cards" data-bloc="S01.7">
      <article class="dcard" aria-label="Demandes reçues cette semaine, données de démonstration">
        <div class="dc-h"><b>Demandes reçues</b><span>Cette semaine</span></div>
        <div class="dc-row">
          <div class="dc-num"><span id="hc-n">38</span><span class="dc-up" id="hc-up">+1</span></div>
          <div class="dc-bars" aria-hidden="true">
            {week.map((w) => (
              <span class={`dc-bar${w.today ? ' now' : ''}${w.v ? '' : ' off'}`}>
                <i id={w.today ? 'hc-today' : undefined} style={`--v:${w.v ? Math.min(w.v / BAR_MAX, 1) : 0.06}`}></i><em>{w.d}</em>
              </span>
            ))}
          </div>
        </div>
        <p class="dc-last"><i class="dc-live"></i><span id="hc-last">Homegate · à l'instant</span></p>
      </article>
      <article class="dcard" aria-label="Stock du projet Les Terrasses : 5 lots vendus, 3 réservés, 4 libres, données de démonstration">
        <div class="dc-h"><b>Les Terrasses</b><span>12 lots</span></div>
        <div class="dc-lots" aria-hidden="true">
          {lots.map((l, i) => <span class={`lot ${l.s}`} style={`--i:${i}`}>{l.id}</span>)}
        </div>
        <ul class="dc-leg"><li><i class="s"></i>5 vendus</li><li><i class="r"></i>3 réservés</li><li><i class="f"></i>4 libres</li></ul>
      </article>
    </div>
  </div>
</header>
<script>
  import '../scripts/hero.ts';
</script>
