---
// S01 · Hero (réf. Synais, captures fournies par Diego le 11.11.2026), version 3 « épurée » :
// titre court en deux tons, une main qui tient l'objet Lotivio, cinq canaux posés sur des fils fins.
// Une impulsion à la fois part d'un canal, arrive dans l'objet et fait monter la carte « Demandes reçues ».
// Photo : Higgsfield Soul 2.0 (job c31cb2a1…), détourée (job d86eb069…), logo Lotivio posé en composition.
// Sources de la photo : assets/hero/2026-11-11-main-soul2/. Versions précédentes : proofs/archive/S01Hero-v1…, -v2….
import '../styles/hero-circuit.css';

/* ---------- Géométrie : scène de 1920 × 960, cadre utile de 1440 px à partir de x = 240 ---------- */
type P = [number, number];
function route(pts: P[], r = 14) {
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const [px, py] = pts[i - 1], [cx, cy] = pts[i], [nx, ny] = pts[i + 1];
    const l1 = Math.hypot(cx - px, cy - py), l2 = Math.hypot(nx - cx, ny - cy);
    const k = Math.min(r, l1 / 2, l2 / 2);
    const ax = cx - ((cx - px) / l1) * k, ay = cy - ((cy - py) / l1) * k;
    const bx = cx + ((nx - cx) / l2) * k, by = cy + ((ny - cy) / l2) * k;
    d += ` L${ax.toFixed(1)} ${ay.toFixed(1)} Q${cx} ${cy} ${bx.toFixed(1)} ${by.toFixed(1)}`;
  }
  const [lx, ly] = pts[pts.length - 1];
  return d + ` L${lx} ${ly}`;
}
const length = (pts: P[]) => pts.slice(1).reduce((s, p, i) => s + Math.hypot(p[0] - pts[i][0], p[1] - pts[i][1]), 0);
function along(pts: P[], q: P) {
  let best = Infinity, at = 0, acc = 0;
  for (let i = 1; i < pts.length; i++) {
    const [ax, ay] = pts[i - 1], [bx, by] = pts[i];
    const L = Math.hypot(bx - ax, by - ay);
    const t = Math.max(0, Math.min(1, ((q[0] - ax) * (bx - ax) + (q[1] - ay) * (by - ay)) / (L * L || 1)));
    const dd = Math.hypot(ax + (bx - ax) * t - q[0], ay + (by - ay) * t - q[1]);
    if (dd < best) { best = dd; at = acc + L * t; }
    acc += L;
  }
  return at;
}

const DEV: P = [720, 690]; // (la photo est descendue de 40 px : les fils finissent sous l'objet)          // centre de l'objet dans la photo, en coordonnées de scène
const SPEED = 300, DASH = 46, CYCLE = 12, STEP = CYCLE / 5; // une arrivée toutes les 2,4 s

type Src = { name: string; icon: string; pts: P[]; tile: P; tileM: P | null };
const sources: Src[] = [
  { name: 'Homegate', icon: 'homegate', pts: [[-260, 450], [260, 450], [260, 630], [720, 630]], tile: [260, 540], tileM: [478, 630] },
  { name: 'WhatsApp', icon: 'whatsapp', pts: [[1700, 470], [1170, 470], [1170, 645], [720, 645]], tile: [1170, 558], tileM: [962, 645] },
  { name: 'Meta Ads', icon: 'meta', pts: [[-260, 610], [110, 610], [110, 700], [720, 700]], tile: [400, 700], tileM: [455, 700] },
  { name: 'immobilier.ch', icon: 'immo', pts: [[1700, 640], [1340, 640], [1340, 715], [720, 715]], tile: [1030, 715], tileM: [985, 715] },
  { name: 'Votre site', icon: 'site', pts: [[-260, 790], [500, 790], [500, 760], [720, 760]], tile: [300, 790], tileM: null },
];
const wires = sources.map((s, i) => {
  const L = length(s.pts), o1 = -(L + 8), o0 = o1 + CYCLE * SPEED, start = -i * STEP - 0.4;
  const flash = (q: P | null) => (q ? start + (o0 - DASH + along(s.pts, q)) / SPEED : 0);
  return { ...s, d: route(s.pts), o0, o1, start, dl: flash(s.tile), dlm: flash(s.tileM) };
});
const decor: P[][] = [
  [[-260, 300], [70, 300], [70, 382]],
  [[1700, 320], [1300, 320], [1300, 404]],
  [[1700, 830], [1470, 830], [1470, 980]],
];
const ends: P[] = [[70, 382], [1300, 404]];
const feed = route([[720, 770], [945, 770], [945, 805]]);
const tools: { at: P; g: string; v?: boolean }[] = [
  { at: [110, 655], g: 'dots', v: true },
  { at: [1340, 678], g: 'bars', v: true },
  { at: [70, 340], g: 'grid', v: true },
  { at: [1470, 900], g: 'dots', v: true },
];
const px = (x: number) => x + 240;

// Photo : centre de l'objet à (410, 408) dans le recadrage de 980 × 1828 px.
const IMG_W = 440, k = IMG_W / 980;
const img = { w: IMG_W, h: Math.round(1828 * k), left: px(DEV[0]) - Math.round(410 * k), top: DEV[1] - Math.round(408 * k) + 40 };

const ICON: Record<string, string> = {
  homegate: '<span class="ic-hg" style="background-image:url(/media/logos/homegate.svg)"></span>',
  meta: '<span class="ic-meta" style="background-image:url(/media/logos/meta-64.webp)"></span>',
  immo: '<img src="/media/logos/immobilier-ch-96.webp" alt="" width="20" height="20" />',
  whatsapp: '<img src="/media/logos/whatsapp.svg" alt="" width="20" height="20" />',
  site: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.8 3 2.8 15 0 18M12 3c-2.8 3-2.8 15 0 18"/></svg>',
};
