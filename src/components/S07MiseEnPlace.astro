---
const tex = ['/media/residence-480.webp', '/media/lac-480.webp', '/media/residence-portrait-480.webp'];

// Illustrations animées (bento) : chaque scène est jouée par src/scripts/bento.ts,
// qui pose les classes d'étape k1, k2… sur .il selon data-steps (ms) ; les mouvements sont
// des transitions CSS (global.css, « S07 · illustrations bento »). Sans JavaScript ou avec
// moins de mouvement, la scène s'affiche dans son état final. Données de démonstration.
const ico = {
  check: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.4l2.9 2.8 6-6.4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  cursor: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3l14 8.2-6.3 1.4 3.6 6.6-2.6 1.4-3.6-6.6L5 18.2z" fill="#141414" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/></svg>',
  mail: '<svg viewBox="0 0 20 20" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 6l6.5 5 6.5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
  globe: '<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M2.8 10h14.4M10 2.7c2.2 2.3 2.2 12.3 0 14.6M10 2.7c-2.2 2.3-2.2 12.3 0 14.6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>',
  arrow: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12L12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  sheet: '<svg viewBox="0 0 32 40" aria-hidden="true"><path d="M4 2h16l8 8v26a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" fill="#fff" stroke="#DCDAD4" stroke-width="1.5"/><path d="M20 2v8h8" fill="#F4F3F0" stroke="#DCDAD4" stroke-width="1.5" stroke-linejoin="round"/><path d="M7 18h18M7 23h18M7 28h18M14 15v17" stroke="#C9C6BF" stroke-width="1.3"/></svg>',
  pdf: '<svg viewBox="0 0 32 40" aria-hidden="true"><path d="M4 2h16l8 8v26a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" fill="#fff" stroke="#DCDAD4" stroke-width="1.5"/><rect x="5" y="22" width="22" height="10" rx="2" fill="#EB6E2C"/><text x="16" y="29.6" text-anchor="middle" font-size="7" font-family="ui-monospace,monospace" fill="#fff">PDF</text></svg>',
};

// S07.2 · carte des branchements (coordonnées de la tuile : 374 × 224, centre 187,124)
const hubL = [
  { y: 70, html: '<img src="/media/logos/homegate.svg" alt="" width="73" height="12" style="height:1.25em">' },
  { y: 124, html: '<img src="/media/logos/immoscout24.svg" alt="" width="33" height="20" style="height:2em">' },
  { y: 178, html: '<img src="/media/logos/immobilier-ch.svg" alt="" width="85" height="12" style="height:1.2em">' },
];
const hubR = [
  { y: 70, html: `<span class="il-i">${ico.globe}</span>Votre site`, dir: 'in' },
  { y: 124, html: '<img src="/media/logos/whatsapp.svg" alt="" width="18" height="18" style="height:1.8em">WhatsApp', dir: 'both' },
  { y: 178, html: `<span class="il-i">${ico.mail}</span>Outlook · envoi`, dir: 'out' },
];
const curveL = (y: number) => `M114 ${y}C146 ${y} 146 124 158 124`;
const curveR = (y: number) => `M260 ${y}C228 ${y} 228 124 216 124`;
---
<!-- S07 · Mise en place -->
<section class="hs" id="mise-en-place">
  <div class="hs-intro hs-intro-m" style="padding:0 var(--pad) 22px">
    <span class="eyb">🇨🇭 Pensé pour votre agence</span>
    <h2 data-flash>Votre méthode.<br />Votre Lotivio.</h2>
    <p>Chaque agence suisse a ses outils. Chaque agent, ses habitudes. Nous partons de votre quotidien pour connecter vos canaux et régler votre suivi.</p>
  </div>
  <div class="hs-pin">
    <div class="hs-track" id="hs-track">
      <div class="hs-intro" data-bloc="S07.0">
        <span class="eyb" data-scramble>🇨🇭 Pensé pour votre agence</span>
        <h2 data-flash>Votre méthode.<br />Votre Lotivio.</h2>
        <p>Chaque agence suisse a ses outils. Chaque agent, ses habitudes. Nous partons de votre quotidien pour connecter vos canaux et régler votre suivi.</p>
      </div>

      <!-- S07.1 · Atelier : la carte de fonctionnement de l'agence se dessine -->
      <article class="oc" data-bloc="S07.1"><pre class="tex ctex" data-src={tex[0]} data-w=".38" data-r=".95" aria-hidden="true"></pre>
        <span class="nb">1</span>
        <div class="ill" aria-hidden="true">
          <div class="il il1" data-steps="300,1000,1700,2100,2700,3300,4600,5600,6700" data-loop="9000">
            <div class="t t-map">
              <div class="t-h"><span class="lb">Votre fonctionnement</span><span class="live"><i></i>Atelier</span></div>
              <div class="sc map">
                <svg class="il-svg" viewBox="0 0 346 136">
                  <path class="dr d1" pathLength="1" d="M94 20C114 20 110 68 128 68" />
                  <path class="dr d2" pathLength="1" d="M94 68L128 68" />
                  <path class="dr d3" pathLength="1" d="M94 116C114 116 110 68 128 68" />
                  <path class="dr d4" pathLength="1" d="M218 68C234 68 228 36 244 36" />
                  <path class="dr d5" pathLength="1" d="M218 68C234 68 228 100 244 100" />
                  <path class="pu p1" pathLength="1" d="M94 20C114 20 110 68 128 68L218 68C234 68 228 36 244 36" />
                  <path class="pu p2" pathLength="1" d="M94 116C114 116 110 68 128 68L218 68C234 68 228 100 244 100" />
                  <path class="pu p3" pathLength="1" d="M94 68L218 68C234 68 228 36 244 36" />
                </svg>
                <span class="nd src s1" style="top:14.7%">Portails</span>
                <span class="nd src s2" style="top:50%">Votre site</span>
                <span class="nd src s3" style="top:85.3%">Meta Ads</span>
                <span class="nd hub1">Demande</span>
                <span class="nd ag a1" style="top:26.5%"><b>SK</b>répond<em class="ok"><Fragment set:html={ico.check} /></em></span>
                <span class="nd ag a2" style="top:73.5%"><b>DL</b>relance<em class="ok"><Fragment set:html={ico.check} /></em></span>
                <span class="cur c1"><Fragment set:html={ico.cursor} /></span>
              </div>
            </div>
            <div class="t dk t-q">
              <span class="lb">À l’atelier</span>
              <div class="qs"><span class="q q1">D’où viennent vos demandes<i>?</i></span><span class="q q2">Qui répond<i>?</i></span><span class="q q3">Qui relance<i>?</i></span></div>
              <div class="qd"><i></i><i></i><i></i></div>
            </div>
            <div class="t t-team">
              <span class="lb">Votre équipe</span>
              <div class="sc avs"><span class="av v1">SK</span><span class="av v2">DL</span><span class="av v3">MR</span><span class="av v4">AN</span></div>
              <span class="sc role"><span class="ok"><Fragment set:html={ico.check} /></span>Rôles définis</span>
            </div>
          </div>
        </div>
        <h3>On part de votre quotidien</h3>
        <p>D’où viennent vos demandes ? Qui répond, qui relance ? Nous définissons le fonctionnement de Lotivio avec votre équipe.</p>
      </article>

      <!-- S07.2 · Branchements : chaque canal se connecte, dans le bon sens -->
      <article class="oc" data-bloc="S07.2"><pre class="tex ctex" data-src={tex[1]} data-w=".38" data-r=".95" aria-hidden="true"></pre>
        <span class="nb">2</span>
        <div class="ill" aria-hidden="true">
          <div class="il il2" data-steps="200,600,1500,2400,3000" data-loop="9000">
            <div class="t t-hub">
              <div class="t-h"><span class="lb">Branchements</span><span class="live"><i></i>Exemple</span></div>
              <div class="sc hubz">
                <svg class="il-svg" viewBox="0 0 374 224">
                  {hubL.map((n, i) => <path class={`dr d${i + 1}`} pathLength="1" d={curveL(n.y)} />)}
                  {hubR.map((n, i) => <path class={`dr d${i + 4}`} pathLength="1" d={curveR(n.y)} />)}
                  <path class="dr d7" pathLength="1" d="M187 62L187 96" />
                  <path class="dr d8" pathLength="1" d="M187 186L187 152" />
                  {hubL.map((n, i) => <path class={`pu in p${i + 1}`} pathLength="1" d={curveL(n.y)} />)}
                  <path class="pu in p4" pathLength="1" d={curveR(70)} />
                  <path class="pu in p5" pathLength="1" d={curveR(124)} />
                  <path class="pu out p6" pathLength="1" d="M216 124C228 124 228 124 260 124" />
                  <path class="pu out p7" pathLength="1" d="M216 124C228 124 228 178 260 178" />
                  <path class="pu in p8" pathLength="1" d="M187 62L187 96" />
                  <path class="pu in p9" pathLength="1" d="M187 186L187 152" />
                </svg>
                <span class="core"><img src="/brand/lotivio-mark.svg" alt="" width="34" height="34" /></span>
                {hubL.map((n, i) => <span class={`pill l n${i + 1}`} style={`top:${(n.y / 224) * 100}%`}><Fragment set:html={n.html} /><em class="ok"><Fragment set:html={ico.check} /></em></span>)}
                {hubR.map((n, i) => <span class={`pill r n${i + 4} ${n.dir}`} style={`top:${(n.y / 224) * 100}%`}><Fragment set:html={n.html} /><em class="ok"><Fragment set:html={ico.check} /></em></span>)}
                <span class="pill c n7" style="top:23.2%"><img src="/media/logos/meta-64.webp" alt="" width="68" height="14" style="height:1.35em" /><em class="ok"><Fragment set:html={ico.check} /></em></span>
                <span class="pill c n8" style="top:89.3%"><img src="/media/logos/properstar-logo-84.webp" alt="" width="84" height="13" style="height:1.3em" /><em class="ok"><Fragment set:html={ico.check} /></em></span>
              </div>
            </div>
            <div class="t t-in">
              <span class="lb">Demandes reçues</span>
              <div class="sc rows">
                <span class="rw w1"><b>Homegate</b>Clos des Vergers</span>
                <span class="rw w2"><b>Meta Ads</b>Les Terrasses</span>
                <span class="rw w3"><b>Votre site</b>Lac &amp; Lumière</span>
              </div>
            </div>
            <div class="t dk t-out">
              <span class="lb">Envois</span>
              <div class="sc outs">
                <span class="ot o1"><span class="il-i"><Fragment set:html={ico.mail} /></span>E-mail via Outlook<span class="go"><Fragment set:html={ico.arrow} /></span></span>
                <span class="ot o2"><img src="/media/logos/whatsapp.svg" alt="" width="14" height="14" />WhatsApp<span class="go"><Fragment set:html={ico.arrow} /></span></span>
              </div>
            </div>
          </div>
        </div>
        <h3>Vos outils, connectés</h3>
        <p>Portails, site, Meta Ads, WhatsApp professionnel et envoi via Outlook : nous configurons les connexions utiles à votre agence.</p>
      </article>

      <!-- S07.3 · Parcours : l'agence choisit ce qui part seul et ce que l'agent valide -->
      <article class="oc" data-bloc="S07.3"><pre class="tex ctex" data-src={tex[2]} data-w=".38" data-r=".95" aria-hidden="true"></pre>
        <span class="nb">3</span>
        <div class="ill" aria-hidden="true">
          <div class="il il3" data-steps="300,1100,1900,2500,3000,3700,4200,4900,6000,6500" data-loop="9000">
            <div class="t t-flow">
              <div class="t-h"><span class="lb">Parcours d’une demande</span><span class="live"><i></i>Exemple</span></div>
              <div class="sc steps">
                <span class="rail"><i class="dot"></i></span>
                <div class="st st1"><i class="nd2"></i><span class="nm"><b>Premier contact</b><small class="ss"><span class="sw-a">En file</span><span class="sw-b"><Fragment set:html={ico.check} />Envoyé</span></small></span><span class="tg on"><i></i><span>Auto</span></span></div>
                <div class="st st2"><i class="nd2"></i><span class="nm"><b>Brochure · WhatsApp</b><small class="ss"><span class="sw-a">En file</span><span class="sw-b"><Fragment set:html={ico.check} />Envoyée</span></small></span><span class="tg on"><i></i><span>Auto</span></span></div>
                <div class="st st3"><i class="nd2"></i><span class="nm"><b>Relance · e-mail</b><small class="ss"><span class="sw-a">En file</span><span class="sw-w">L’agent valide…</span><span class="sw-b"><Fragment set:html={ico.check} />Validée, envoyée</span></small></span><span class="tg flip"><i></i><span class="ta">Auto</span><span class="tb">Agent</span></span></div>
                <span class="cur c3"><Fragment set:html={ico.cursor} /></span>
              </div>
            </div>
            <div class="t t-bro">
              <span class="lb">Brochure</span>
              <div class="sc bro">
                <span class="doc"><Fragment set:html={ico.pdf} /></span>
                <span class="bub"><img src="/media/logos/whatsapp.svg" alt="" width="14" height="14" />Brochure envoyée</span>
              </div>
            </div>
            <div class="t dk t-ok">
              <span class="lb">À valider</span>
              <div class="sc val">
                <span class="vr"><b>SK</b><span>Relance prête<small>Léa Perrin</small></span></span>
                <span class="btn-v"><span class="v-a">Valider</span><span class="v-b"><Fragment set:html={ico.check} />Validé</span></span>
              </div>
            </div>
          </div>
        </div>
        <h3>Vous décidez du suivi</h3>
        <p>Premier contact, envoi de brochure, relance : nous définissons avec vous ce qui part automatiquement et ce que l’agent valide.</p>
      </article>

      <!-- S07.4 · Assistant : la réponse s'appuie sur la fiche projet et les consignes -->
      <article class="oc" data-bloc="S07.4"><pre class="tex ctex" data-src={tex[0]} data-w=".38" data-r=".95" aria-hidden="true"></pre>
        <span class="nb">4</span>
        <div class="ill" aria-hidden="true">
          <div class="il il4" data-steps="300,1400,2100,3600,5000" data-loop="9000">
            <div class="t t-doc">
              <span class="lb">Fiche projet</span>
              <div class="sc doc4">
                <b class="pj">Les Terrasses du Vignoble</b>
                <span class="scan"></span>
                <span class="lot"><b>A2</b>4.5 p.<em class="x">Vendu</em></span>
                <span class="lot hit"><b>B4</b>3.5 p.<em class="y">Disponible</em></span>
                <span class="lot"><b>C1</b>2.5 p.<em class="z">Réservé</em></span>
              </div>
            </div>
            <div class="t t-rules">
              <span class="lb">Consignes</span>
              <div class="sc rules">
                <span class="ru r1"><em class="ok"><Fragment set:html={ico.check} /></em>Vouvoyer</span>
                <span class="ru r2"><em class="ok"><Fragment set:html={ico.check} /></em>Prix si demandé</span>
                <span class="ru r3"><em class="ok"><Fragment set:html={ico.check} /></em>Visite le samedi</span>
              </div>
            </div>
            <div class="t t-chat">
              <div class="t-h"><span class="lb">Conversation</span><span class="live"><img src="/media/logos/whatsapp.svg" alt="" width="12" height="12" />Démo</span></div>
              <div class="sc chat4">
                <span class="bq">Le lot B4 est-il encore disponible ?</span>
                <span class="typ"><i></i><i></i><i></i></span>
                <span class="ba">Oui, le lot B4 (3.5 pièces) est disponible. Souhaitez-vous le visiter samedi matin ?</span>
                <span class="srcx"><i></i>Source : fiche projet · lot B4</span>
              </div>
            </div>
          </div>
        </div>
        <h3>L’IA connaît vos projets</h3>
        <p>Nous réglons l’assistant avec vos fiches projet, votre ton et vos consignes. Ses réponses s’appuient sur les informations de l’agence.</p>
      </article>

      <!-- S07.5 · Mise en route : import, équipe en ligne, première demande prise en charge -->
      <article class="oc" data-bloc="S07.5"><pre class="tex ctex" data-src={tex[1]} data-w=".38" data-r=".95" aria-hidden="true"></pre>
        <span class="nb">5</span>
        <div class="ill" aria-hidden="true">
          <div class="il il5" data-steps="300,600,2900,3500,4800,6000" data-loop="9000">
            <div class="t t-imp">
              <div class="t-h"><span class="lb">Import des contacts</span><span class="stx"><span class="sx-a">En cours</span><span class="sx-b"><Fragment set:html={ico.check} />Terminé</span></span></div>
              <div class="sc imp">
                <span class="file"><Fragment set:html={ico.sheet} /><small>contacts.csv</small></span>
                <span class="flow"><i></i><i></i><i></i></span>
                <div class="cl">
                  <span class="cr c1"><b>NG</b><i></i><i class="s"></i></span>
                  <span class="cr c2"><b>YR</b><i></i><i class="s"></i></span>
                  <span class="cr c3"><b>CM</b><i></i><i class="s"></i></span>
                </div>
                <span class="bar"><i></i></span><span class="pct"></span>
              </div>
            </div>
            <div class="t t-team5">
              <span class="lb">Équipe en ligne</span>
              <div class="sc tm5"><span class="av"><b>SK</b><i></i></span><span class="av"><b>DL</b><i></i></span><span class="av"><b>MR</b><i></i></span><span class="av"><b>AN</b><i></i></span></div>
            </div>
            <div class="t dk t-new">
              <span class="lb">Nouvelle demande</span>
              <div class="sc nw">
                <span class="nc"><b>Homegate</b>Clos des Vergers · Lot A2<span class="tap"></span></span>
                <span class="take"><b>DL</b>Prise en charge</span>
              </div>
            </div>
          </div>
        </div>
        <h3>Vos agents prennent la main</h3>
        <p>Import des contacts et prise en main sur vos projets : l’équipe apprend à traiter ses demandes et à retrouver son suivi.</p>
      </article>
    </div>
  </div>
  <div class="swipe" aria-hidden="true"><i><b></b><b></b><b></b></i>Faire glisser</div>
</section>
