---
import Btn from './ui/Btn.astro';
import '../styles/s07-mise-en-place.css';
import '../styles/s07-scenes.css';
// Textes de Diego du 12.11.2026 (4 cartes). Version à 5 cartes : proofs/archive/S07MiseEnPlace-v1-5-cartes.astro
const tex = ['/media/tex/facade.svg', '/media/tex/chantier.svg', '/media/tex/quartier.svg'];

// Icônes des illustrations (cartes S07).
const ico = {
  check: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.4l2.9 2.8 6-6.4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  cursor: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3l14 8.2-6.3 1.4 3.6 6.6-2.6 1.4-3.6-6.6L5 18.2z" fill="#141414" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/></svg>',
  mail: '<svg viewBox="0 0 20 20" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 6l6.5 5 6.5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
  globe: '<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M2.8 10h14.4M10 2.7c2.2 2.3 2.2 12.3 0 14.6M10 2.7c-2.2 2.3-2.2 12.3 0 14.6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>',
  arrow: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12L12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  sheet: '<svg viewBox="0 0 32 40" aria-hidden="true"><path d="M4 2h16l8 8v26a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" fill="#fff" stroke="#DCDAD4" stroke-width="1.5"/><path d="M20 2v8h8" fill="#F4F3F0" stroke="#DCDAD4" stroke-width="1.5" stroke-linejoin="round"/><path d="M7 18h18M7 23h18M7 28h18M14 15v17" stroke="#C9C6BF" stroke-width="1.3"/></svg>',
  pdf: '<svg viewBox="0 0 32 40" aria-hidden="true"><path d="M4 2h16l8 8v26a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" fill="#fff" stroke="#DCDAD4" stroke-width="1.5"/><rect x="5" y="22" width="22" height="10" rx="2" fill="#EB6E2C"/><text x="16" y="29.6" text-anchor="middle" font-size="7" font-family="ui-monospace,monospace" fill="#fff">PDF</text></svg>',
};

// v4 (12.11.2026) : une carte par étape, peu d'éléments, grandes lignes lisibles ; la scène se joue une fois
// à chaque apparition puis reste immobile (src/scripts/s07.ts, styles s07-scenes.css). Version chargée :
// proofs/archive/S07MiseEnPlace-v3-scenes-chargees.astro. Portraits de démonstration existants.
const P = (k: string) => `/media/${k[0] === 'c' ? 'contacts' : 'leads'}/${k}.webp`;
// Canaux (carte 02) : 3 à gauche, 3 à droite, autour de Lotivio. Repère 338 × 180, centre 169,90.
const chL = [
  { y: 30, html: '<img src="/media/logos/homegate.svg" alt="" width="73" height="12" style="height:1.2em">' },
  { y: 90, html: '<img src="/media/logos/immoscout24.svg" alt="" width="33" height="20" style="height:2em">' },
  { y: 150, html: '<img src="/media/logos/immobilier-ch.svg" alt="" width="85" height="12" style="height:1.15em">' },
];
const chR = [
  { y: 30, html: '<img src="/media/logos/meta-64.webp" alt="" width="68" height="14" style="height:1.35em">' },
  { y: 90, html: '<img src="/media/logos/whatsapp.svg" alt="" width="18" height="18" style="height:1.6em">WhatsApp' },
  { y: 150, html: `<span class="il-i">${ico.globe}</span>Votre site` },
];
const cL = (y: number) => `M100 ${y}C128 ${y} 124 90 139 90`;
const cR = (y: number) => `M238 ${y}C210 ${y} 214 90 199 90`;
---
<!-- S07 · Mise en place -->
<section class="hs" id="mise-en-place">
  <div class="hs-intro hs-intro-m" style="padding:0 var(--pad) 22px">
    <span class="eyb">🇨🇭 Pensé pour votre agence</span>
    <h2 data-flash>Votre équipe a des biens à vendre.<br />Nous préparons votre Lotivio.</h2>
    <p>De la reprise de vos contacts à la prise en main, nous installons Lotivio selon votre fonctionnement. Vous définissez vos besoins avec nous ; nous prenons en charge les connexions et les réglages.</p>
  </div>
  <div class="hs-pin">
    <div class="hs-track" id="hs-track">
      <div class="hs-intro" data-bloc="S07.0">
        <span class="eyb" data-scramble>🇨🇭 Pensé pour votre agence</span>
        <h2 data-flash>Votre équipe a des biens à vendre.<br />Nous préparons votre Lotivio.</h2>
        <p>De la reprise de vos contacts à la prise en main, nous installons Lotivio selon votre fonctionnement. Vous définissez vos besoins avec nous ; nous prenons en charge les connexions et les réglages.</p>
      </div>

      <!-- S07.1 · Atelier : la carte de fonctionnement de l'agence se dessine -->
      <article class="oc" data-bloc="S07.1"><pre class="tex ctex" data-src={tex[0]} data-w=".38" data-r=".95" aria-hidden="true"></pre>
        <span class="nb">1</span>
        <div class="ill" aria-hidden="true">
          <div class="s7 s7-at" data-s7>
            <div class="t">
              <div class="t-h"><span class="lb">Votre fonctionnement</span><span class="live"><i></i>Atelier</span></div>
              <div class="s7-rows">
                <div class="s7-r on done" data-t="200" data-d="900"><span class="ic">1</span><span class="tx"><small>D’où viennent vos demandes ?</small><b>Portails, Meta Ads, votre site</b></span><em class="ok"><Fragment set:html={ico.check} /></em></div>
                <div class="s7-r on done" data-t="1100" data-d="1800"><b class="ia">SK</b><span class="tx"><small>Qui répond ?</small><b>Sarah K.</b></span><em class="ok"><Fragment set:html={ico.check} /></em></div>
                <div class="s7-r on done" data-t="2000" data-d="2700"><b class="ia o">DL</b><span class="tx"><small>Qui relance ?</small><b>David L. · après 5 jours</b></span><em class="ok"><Fragment set:html={ico.check} /></em></div>
              </div>
              <div class="ft on" data-t="3200"><em class="ok"><Fragment set:html={ico.check} /></em>Rôles définis avec votre équipe</div>
            </div>
          </div>
        </div>
        <h3>Votre façon de travailler devient notre point de départ.</h3>
        <p>Nous regardons comment votre équipe reçoit, qualifie et relance ses contacts. Ensemble, nous identifions les tâches à simplifier et les étapes à automatiser pour concentrer la mise en place sur ce qui vous sera utile.</p>
      </article>

      <!-- S07.2 · Branchements : chaque canal se connecte, dans le bon sens -->
      <article class="oc" data-bloc="S07.2"><pre class="tex ctex" data-src={tex[1]} data-w=".38" data-r=".95" aria-hidden="true"></pre>
        <span class="nb">2</span>
        <div class="ill" aria-hidden="true">
          <div class="s7 s7-cx" data-s7>
            <div class="t">
              <div class="t-h"><span class="lb">Vos canaux</span><span class="live"><i></i>Connectés</span></div>
              <div class="hub">
                <svg class="sv" viewBox="0 0 338 180">
                  {chL.map((n, i) => <path class="dr on" data-t={300 + i * 220} pathLength="1" d={cL(n.y)} />)}
                  {chR.map((n, i) => <path class="dr on" data-t={410 + i * 220} pathLength="1" d={cR(n.y)} />)}
                </svg>
                <span class="core on" data-t="100"><img src="/brand/lotivio-mark.svg" alt="" width="34" height="34" /></span>
                {chL.map((n, i) => <span class="plg pl on done" data-t={300 + i * 220} data-d={650 + i * 220} style={`top:${(n.y / 180) * 100}%`}><Fragment set:html={n.html} /><em class="ok"><Fragment set:html={ico.check} /></em></span>)}
                {chR.map((n, i) => <span class="plg pr on done" data-t={410 + i * 220} data-d={760 + i * 220} style={`top:${(n.y / 180) * 100}%`}><Fragment set:html={n.html} /><em class="ok"><Fragment set:html={ico.check} /></em></span>)}
              </div>
              <div class="s7-r on" data-t="1900"><span class="stk"><img src={P('c1')} alt="" width="160" height="160" loading="lazy" decoding="async" /><img src={P('l2')} alt="" width="160" height="160" loading="lazy" decoding="async" /><img src={P('c4')} alt="" width="160" height="160" loading="lazy" decoding="async" /></span><span class="tx"><small>Contacts et demandes</small><b>Au même endroit</b></span></div>
            </div>
          </div>
        </div>
        <h3>Retrouvez vos contacts. Connectez vos canaux.</h3>
        <p>Nous importons votre base de contacts et configurons les connexions utiles à votre agence : portails, site, Meta Ads, WhatsApp professionnel et envoi d’e-mails. Vous retrouvez vos contacts existants et vos nouvelles demandes dans le même environnement.</p>
      </article>

      <!-- S07.3 · Parcours : l'agence choisit ce qui part seul et ce que l'agent valide -->
      <article class="oc" data-bloc="S07.3"><pre class="tex ctex" data-src={tex[2]} data-w=".38" data-r=".95" aria-hidden="true"></pre>
        <span class="nb">3</span>
        <div class="ill" aria-hidden="true">
          <div class="s7 s7-dl" data-s7>
            <div class="t">
              <div class="t-h"><span class="who on" data-t="100"><img src={P('l1')} alt="" width="160" height="160" loading="lazy" decoding="async" /><span><b>Thomas Rochat</b><small>Nouvelle demande · Meta Ads</small></span></span><span class="live"><i></i>Exemple</span></div>
              <div class="s7-rows">
                <div class="s7-r on done" data-t="500" data-d="1200"><span class="ic">1</span><span class="tx"><b>Premier contact</b><small class="sta"><span class="a">En attente</span><span class="b">Envoyé automatiquement</span></small></span><span class="md">Auto</span></div>
                <div class="s7-r on done" data-t="1400" data-d="2100"><span class="ic">2</span><span class="tx"><b>Brochure · WhatsApp</b><small class="sta"><span class="a">En attente</span><span class="b">Envoyée automatiquement</span></small></span><span class="md">Auto</span></div>
                <div class="s7-r ag on done" data-t="2300" data-d="3600"><span class="ic">3</span><span class="tx"><b>Relance · e-mail</b><small class="sta"><span class="a">À valider par l’agent</span><span class="b">Validée par Sarah K.</span></small></span><span class="md">Agent</span></div>
              </div>
            </div>
          </div>
        </div>
        <h3>Déléguez des tâches. Gardez la main sur la relation.</h3>
        <p>Nous réglons les automatismes avec vous : ce qui peut partir seul, ce que l’agent valide et quand il intervient. Votre assistant IA s’appuie sur vos fiches projet, votre ton et vos consignes pour accompagner le suivi.</p>
      </article>

      <!-- S07.5 · Mise en route : import, équipe en ligne, première demande prise en charge -->
      <article class="oc" data-bloc="S07.5"><pre class="tex ctex" data-src={tex[1]} data-w=".38" data-r=".95" aria-hidden="true"></pre>
        <span class="nb">4</span>
        <div class="ill" aria-hidden="true">
          <div class="s7 s7-pm" data-s7>
            <div class="t">
              <div class="t-h"><span class="lb">Prise en main</span><span class="live"><i></i>Avec votre équipe</span></div>
              <div class="s7-team">
                {['SK', 'DL', 'MR', 'AN'].map((x, k) => <span class={`av v${k} on`} data-t={150 + k * 180}><b>{x}</b><i></i></span>)}
                <span class="onl on" data-t="950">Équipe en ligne</span>
              </div>
              <div class="s7-rows">
                <div class="s7-r on done" data-t="1200" data-d="1800"><span class="ic">1</span><span class="tx"><b>Traiter une demande</b></span><em class="ok"><Fragment set:html={ico.check} /></em></div>
                <div class="s7-r on done" data-t="1700" data-d="2400"><span class="ic">2</span><span class="tx"><b>Retrouver un acheteur</b></span><em class="ok"><Fragment set:html={ico.check} /></em></div>
                <div class="s7-r on done" data-t="2200" data-d="3000"><span class="ic">3</span><span class="tx"><b>Préparer une relance</b></span><em class="ok"><Fragment set:html={ico.check} /></em></div>
              </div>
            </div>
          </div>
        </div>
        <h3>Prenez la main sur vos propres projets.</h3>
        <p>Votre équipe apprend à utiliser Lotivio avec ses biens et ses situations du quotidien. Traiter une demande, retrouver un acheteur, préparer une relance : nous vous accompagnons dans la prise en main pour que chacun sache comment l’utiliser.</p>
      </article>
    </div>
  </div>
  <div class="swipe" aria-hidden="true"><i><b></b><b></b><b></b></i>Faire glisser</div>
</section>
<script>
  // Scènes de la mise en place : chargées quand le navigateur est libre (sous le premier écran).
  const go = () => import('../scripts/s07.ts');
  if ('requestIdleCallback' in window) requestIdleCallback(go, { timeout: 2000 }); else setTimeout(go, 400);
</script>
<div class="par-end hs-end" data-bloc="S07.6"><Btn label="Parlons de votre mise en place" href="#demo" /></div>

