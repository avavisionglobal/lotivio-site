---
import '../styles/s06-parcours.css';
// Textes de Diego du 12.11.2026. Version précédente : proofs/archive/S06Parcours-v1-demande-signature.astro
const panels = [
  { b: 'S06.1', g: 'g1', code: '(Base clients)', h: ['Vos futurs acheteurs sont peut-être', 'déjà dans votre base.'],
    p: 'À chaque nouvelle promotion, retrouvez les contacts dont les critères correspondent à vos biens. Budget, secteur, surface, nombre de pièces : le matching rapproche vos lots des recherches enregistrées. Réactivez ces contacts avec une campagne e-mail ciblée et donnez une nouvelle occasion à votre base de générer des ventes.' },
  { b: 'S06.2', g: 'g2', code: '(Leads)', h: ['Vos leads arrivent.', 'Le suivi fonctionne à votre façon.'],
    p: 'Portails immobiliers, Meta Ads, votre site : les demandes des canaux connectés alimentent directement votre base clients. Premier contact, envoi de brochure, intervention de l’agent : nous configurons le suivi selon votre organisation. Votre équipe retrouve ses prospects, leur contexte et les actions à mener au même endroit.' },
  { b: 'S06.3', g: 'g3', code: '(Qualification)', h: ['Qualifiez mieux.', 'Sachez qui rappeler en priorité.'],
    p: 'Qui attend votre retour ? Qui a cliqué plusieurs fois sur la brochure ? Retrouvez les critères de recherche, les signaux d’intérêt et les relances prioritaires pour concentrer vos efforts. Après une visite, dictez votre compte rendu : l’IA prépare les informations à valider pour poursuivre le suivi.' },
  { b: 'S06.4', g: 'g4', code: '(Pilotage)', h: ['Voyez ce qui se vend.', 'Comprenez d’où viennent les acheteurs.'],
    p: 'Suivez vos dossiers jusqu’à la signature, retrouvez les lots disponibles, réservés ou vendus et l’origine de vos acheteurs. Vous avez les informations pour décider quels contacts reprendre, quels biens mettre en avant et quelles actions d’acquisition poursuivre.' },
];
// Matching (panneau 01) : données de démonstration. Le score est une règle (budget, zone, type, surface, pièces…), pas l'IA.
const matches = [
  ['CF', 'Céline Favre', '4.5 p. · Littoral · ≤ 1,3 mio', 92],
  ['MV', 'Marc Vuilleumier', '4.5 p. · Neuchâtel · ≤ 1,25 mio', 87],
  ['JP', 'Justine Perret', '4 p. · Littoral · ≤ 1,2 mio', 74],
] as const;
const rel = [
  ['/media/residence-800.webp', 'Brochure consultée 3×', 'Céline Favre', 'Les Terrasses du Vignoble · Lot B3', '50% 50%'],
  ['/media/lac-800.webp', 'Sans réponse depuis 5 jours', 'Justine Perret', 'Résidence Lac & Lumière · Lot D1', '50% 50%'],
  ['/media/residence-portrait-600.webp', 'Match envoyé · 1re relance', 'Aurélie Matthey', 'Clos des Vergers · Lot A2', '50% 30%'],
];
const lots = Array.from({ length: 24 }, (_, i) => String.fromCharCode(65 + Math.floor(i / 8)) + ((i % 8) + 1));
---
<!-- S05 · Parcours — titre -->
<div class="steps-head steps-par" id="parcours" data-bloc="S05">
  <h2 class="h2 h2-par" data-flash>Voici comment Lotivio transforme<span class="g">votre façon de commercialiser une promotion.</span></h2>
  <p>Votre prochaine promotion commence avec un potentiel : les acheteurs que vous connaissez déjà et ceux qui vous découvrent. Exploitez votre base, organisez les nouvelles demandes et concentrez vos efforts sur les contacts à faire avancer. Lotivio relie chaque étape de votre commercialisation.</p>
</div>
<!-- S06 · Parcours — 4 panneaux -->
<section class="flow4" aria-label="Commercialiser une promotion en quatre étapes">
  {panels.map((p, i) => (
    <article class={`pn ${p.g}`} data-bloc={p.b}>
      <span class="pn-dim" aria-hidden="true"></span>
      <div class="pn-in">
        <div class="code">{p.code}</div>
        <div class="top"><h3>{p.h[0]}<br />{p.h[1]}</h3><span class="num">0{i + 1}</span></div>
        <p class="lede">{p.p}</p>
        {i === 0 && (
          <div class="stage">
            <div class="mt" role="img" aria-label="Matching d'un lot avec les contacts de la base, données de démonstration">
              <div class="mt-lot">
                <img src="/media/residence-800.webp" alt="" width="800" height="533" loading="lazy" decoding="async" />
                <div class="mt-lot-b"><span class="mt-k">Nouveau lot</span><b>Les Terrasses du Vignoble · Lot B4</b><span>4.5 pièces · 128 m² · CHF 1'240'000</span><span class="mt-chip">Disponible</span></div>
              </div>
              <div class="mt-list">
                <div class="mt-h"><span>Contacts correspondants</span><b>3</b></div>
                {matches.map(([ini, name, crit, sc]) => (
                  <div class="mt-row"><span class="mt-av">{ini}</span><span class="mt-who"><b>{name}</b><small>{crit}</small></span><span class="mt-sc"><i style={`--w:${sc}%`}></i><span><b>{sc}</b>/100</span></span></div>
                ))}
                <div class="mt-camp"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><span>Campagne e-mail ciblée · 3 contacts</span><em>Prête</em></div>
              </div>
            </div>
          </div>
        )}
        {i === 1 && (
          <div class="stage">
            <h4>Sources branchées</h4><div class="sub">Cette semaine</div>
            <div class="srcs" id="srcs"></div>
          </div>
        )}
        {i === 2 && (
          <div class="stage">
            <div class="rel">
              {rel.map(([img, sig, name, proj, pos]) => (
                <div class="rc"><img src={img} alt="" width="800" height="533" loading="lazy" decoding="async" style={`object-position:${pos}`} /><span class="sig">{sig}</span>
                  <span class="acts"><span title="Traité"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg></span><span class="go" title="Relancer"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" aria-hidden="true"><path d="M4 12h14M13 6l6 6-6 6"/></svg></span></span>
                  <span class="who"><b>{name}</b><span>{proj}</span></span></div>
              ))}
            </div>
          </div>
        )}
        {i === 3 && (
          <div class="stage" style="padding:12px">
            <div class="sale">
              <div class="bgl">{lots.map((l) => <span>{l}</span>)}</div>
              <div class="tool"><div class="in" id="tool"><img src="/brand/lotivio-mark.svg" alt="" width="24" height="24" /><span class="lot">Lot B4</span><span class="stg">Qualifié</span><span class="stg">Réservation</span><span class="stg">Notaire</span><span class="stg">Vendu</span><span class="av">SK</span></div></div>
              <div class="crumb">Pipeline &nbsp;/&nbsp; <b>Les Terrasses du Vignoble</b></div>
            </div>
          </div>
        )}
      </div>
    </article>
  ))}
</section>
<div class="par-end" data-bloc="S06.5"><a class="par-btn" href="#demo">Découvrir ce parcours en démo<span aria-hidden="true">↗</span></a></div>
