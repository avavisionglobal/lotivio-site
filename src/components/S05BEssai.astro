---
import '../styles/s05-essai.css';
// S05B · « Lotivio, sur une vraie promotion » — V2 du 12.11.2026.
// Retour de Diego sur la V1 (6 étapes à valider une par une) : plus beau, valeurs présélectionnées, vision globale
// de l'outil (Aujourd'hui avec la promotion de Kerzers, ce qui s'ouvre au clic, pipeline, ce qui se vend, d'où
// viennent les acheteurs). V1 archivée dans proofs/archive/*-v1-etapes.*
// Réplique de l'interface réelle (DESIGN.md de l'app : sidebar noire, cartes blanches hairline, Archivo),
// données fictives, rien n'est envoyé. Visite guidée automatique + exploration libre : src/scripts/essai.ts.
const chapters = [
  ['today', 'Aujourd’hui'],
  ['lead', 'La demande'],
  ['relance', 'Relance'],
  ['match', 'Matching'],
  ['pipe', 'Pipeline'],
  ['promo', 'La promotion'],
  ['vue', 'Vue d’ensemble'],
];
---
<section class="ess-sec" id="essai" data-bloc="S05B" aria-labelledby="ess-title">
  <div class="steps-head ess-head">
    <h2 class="h2 ess-h2" id="ess-title">Lotivio, sur une vraie promotion.<span class="g">De la première demande à la vente.</span></h2>
    <p>Une promotion de 18 appartements à Kerzers. Regardez la visite, ou cliquez dans l’app pour l’explorer vous-même. Données fictives : aucun message n’est envoyé.</p>
  </div>

  <div class="lvs" data-lvs>
    <div class="lvs-top">
      <div class="lvs-cap" aria-live="polite">
        <span class="lvs-k"><b data-cap-n>01</b> / 07 · <span data-cap-k>Aujourd’hui</span></span>
        <p class="lvs-t" data-cap-t>Votre journée, déjà triée.</p>
        <p class="lvs-s" data-cap-s>Demandes, relances et signaux du jour, pour la promotion de Kerzers.</p>
      </div>
      <div class="lvs-ctl">
        <button class="lvs-play" type="button" data-play aria-label="Mettre la visite en pause">
          <svg class="i-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>
          <svg class="i-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"/></svg>
          <span data-play-l>Pause</span>
        </button>
        <span class="lvs-mode" data-mode>Visite guidée</span>
      </div>
    </div>

    <div class="lvs-fit" data-fit>
      <div class="lvs-canvas" data-canvas>
        <div class="lv" data-lv>
          <aside class="lv-side">
            <div class="lv-brand"><span class="lv-logo"><img src="/brand/lotivio-mark.svg" alt="" width="18" height="18" /></span>Lotivio</div>
            <nav class="lv-nav" aria-label="Navigation de la démo">
              <button type="button" data-go="today"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>Aujourd’hui<em data-badge="today"></em></button>
              <button type="button" data-go="leads"><svg viewBox="0 0 24 24"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.5 5h13L22 12v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6z"/></svg>Demandes reçues<em data-badge="leads"></em></button>
              <button type="button" data-go="match"><svg viewBox="0 0 24 24"><path d="M12 3l1.8 4.7L18.5 9.5 13.8 11.3 12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg>Matchings</button>
              <button type="button" data-go="promo"><svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1M10 21v-3h4v3"/></svg>Biens catalogue</button>
              <button type="button" data-go="pipe"><svg viewBox="0 0 24 24"><circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><path d="M6 8.5v7M8.5 6h4a3 3 0 0 1 3 3"/></svg>Pipeline</button>
              <button type="button" data-go="relance"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/></svg>Relance<em data-badge="relance"></em></button>
              <button type="button" data-go="vue"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/></svg>Vue d’ensemble</button>
            </nav>
            <div class="lv-me"><span class="lv-av">SK</span><span><b>Sarah Keller</b><small>Direction</small></span></div>
          </aside>
          <div class="lv-app">
            <header class="lv-top">
              <span class="lv-search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>Rechercher un contact, un bien, un projet…</span>
              <span class="lv-user"><span><b>Sarah Keller</b><small>Direction</small></span><span class="lv-av">SK</span></span>
            </header>
            <main class="lv-main" data-main></main>
          </div>
          <div class="lv-drawer" data-drawer aria-hidden="true"></div>
          <div class="lv-toast" data-toast role="status"></div>
        </div>
        <div class="lv-phone" data-phone aria-hidden="true"></div>
        <span class="lv-cursor" data-cursor aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 3l14 8-6.2 1.6L9.6 19z" fill="#141414" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/></svg></span>
      </div>
    </div>

    <ol class="lvs-chap" aria-label="Chapitres de la visite">
      {chapters.map(([id, label], i) => (
        <li><button type="button" data-chap={i}><span class="lvs-bar"><i></i></span><span class="lvs-cl"><b>0{i + 1}</b>{label}</span></button></li>
      ))}
    </ol>
  </div>
</section>

<script>
  import '../scripts/essai.ts';
</script>
