---
const key = (id: string) => `<svg class="key" viewBox="0 0 200 80" aria-hidden="true"><defs><linearGradient id="${id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F4F4F4"/><stop offset=".5" stop-color="#C2C2C2"/><stop offset="1" stop-color="#8A8A8A"/></linearGradient></defs><g fill="url(#${id})"><path fill-rule="evenodd" d="M122 40a28 28 0 1 0 56 0a28 28 0 1 0 -56 0zM140 40a10 10 0 1 0 20 0a10 10 0 1 0 -20 0z"/><rect x="108" y="31" width="18" height="18" rx="3"/><rect x="18" y="35" width="94" height="10" rx="2"/><path d="M18 45h8v9h7v-6h7v8h7v-5h7v-6z"/></g></svg>`;
const tags = [
  { b: 'S07B.1', c: 't1', x: -360, y: 430, r: -64, k: 'Temps gagné', small: 'jusqu’à', n: '4 h', t: 'par semaine et par agent' },
  { b: 'S07B.2', c: 't2', x: 40, y: 520, r: 22, k: 'Leads Meta Ads', small: '', n: '24/7', t: 'Max qualifie vos leads Meta sur WhatsApp' },
  { b: 'S07B.3', c: 't3', x: 400, y: 400, r: 58, k: 'Historique', small: '', n: '1', t: 'pour retrouver le suivi de chaque contact' },
];
const hooks = [[150, 'A1'], [275, 'A2'], [400, 'B4'], [525, 'C1'], [650, 'C3']];
---
<!-- S07B · Pourquoi maintenant -->
<section class="why" id="pourquoi">
  <div class="why-pin">
    <div class="why-head" id="why-head" data-bloc="S07B.0">
      <span class="eyb">L’acquisition a changé. Le suivi aussi.</span>
      <h2>Vos canaux. Un seul suivi.</h2>
      <p>Un prospect découvre un projet sur Instagram, demande une brochure et poursuit sur WhatsApp. Votre équipe doit pouvoir suivre. Avec Lotivio, les demandes, les envois et le suivi se retrouvent dans le CRM.</p>
    </div>
    <div class="board" id="board">
      <div class="board-cap" aria-hidden="true" data-bloc="S07B.5">Le tableau des clés de votre agence</div>
      <div class="rail" aria-hidden="true"><span class="screw" style="left:54px"></span><span class="screw" style="right:54px"></span>
        {hooks.map(([x, l]) => <span class="hk" style={`left:${x}px`}><b>{l}</b><i></i></span>)}
      </div>
      {tags.map((t, i) => (
        <div class={`tag ${t.c}`} data-x={t.x} data-y={t.y} data-r={t.r} data-bloc={t.b}>
          <span class="ring" aria-hidden="true"></span><Fragment set:html={key(`kg${i + 1}`)} />
          <div class="fob"><span class="hole" aria-hidden="true"></span>
            <span class="bm">lotivio<i>.</i></span>
            <div class="ins"><span class="k">{t.k}</span><span class="n">{t.small && <small>{t.small}</small>}{t.n}</span><span class="t">{t.t}</span></div>
          </div>
        </div>
      ))}
    </div>
    <a class="why-cta magnet" id="why-cta" href="#demo" data-bloc="S07B.4">Réserver une démo <span aria-hidden="true">→</span></a>
  </div>
</section>
