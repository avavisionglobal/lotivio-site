---
import Base from '../layouts/Base.astro';
import S00Nav from '../components/S00Nav.astro';
import S01Hero from '../components/S01Hero.astro';
import S02Temps from '../components/S02Temps.astro';
import S03Produit from '../components/S03Produit.astro';
import S04IA from '../components/S04IA.astro';
import S06Parcours from '../components/S06Parcours.astro';
import S07MiseEnPlace from '../components/S07MiseEnPlace.astro';
import S07BPourquoi from '../components/S07BPourquoi.astro';
import S08Direction from '../components/S08Direction.astro';
import S09Questions from '../components/S09Questions.astro';
import S10Demo from '../components/S10Demo.astro';
import S11Footer from '../components/S11Footer.astro';
import Film from '../components/Film.astro';
---
<Base>
  <S00Nav />
  <div class="page" id="page">
    <S01Hero />
    <main>
      <S02Temps />
      <S03Produit />
      <S04IA />
      <S06Parcours />
      <S07MiseEnPlace />
      <S07BPourquoi />
      <S08Direction />
      <S09Questions />
      <S10Demo />
    </main>
  </div>
  <S11Footer />
  <Film />
  <script>
    import '../scripts/app.ts';
    import '../scripts/motion.ts';
  </script>
</Base>
