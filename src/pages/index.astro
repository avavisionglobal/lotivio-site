---
import Base from '../layouts/Base.astro';
import S00Nav from '../components/S00Nav.astro';
import S01Hero from '../components/S01Hero.astro';
import S02Temps from '../components/S02Temps.astro';
import S03Produit from '../components/S03Produit.astro';
import S06Parcours from '../components/S06Parcours.astro';
import S07MiseEnPlace from '../components/S07MiseEnPlace.astro';
import S08Cta from '../components/S08Cta.astro';
import S09Questions from '../components/S09Questions.astro';
import S09BTarifs from '../components/S09BTarifs.astro';
import S10Demo from '../components/S10Demo.astro';
import S11Footer from '../components/S11Footer.astro';
import Film from '../components/Film.astro';
---
<Base>
  <S00Nav />
  <div class="page" id="page">
    <S01Hero />
    <main>
      <S02Temps />
      <S03Produit />
      <S06Parcours />
      <S07MiseEnPlace />
      <S08Cta />
      <S09Questions />
      <S09BTarifs />
      <S10Demo />
    </main>
  </div>
  <S11Footer />
  <Film />
  <script>
    // Comportements des sections (titres, trames de code, démos, réservation, menu) : lancés juste après
    // le premier affichage, quand le navigateur est libre. Le premier écran (hero.ts) n'attend pas.
    const later = (fn: () => void, t = 1000) => ('requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: t }) : setTimeout(fn, 200));
    requestAnimationFrame(() => later(() => { import('../scripts/flash.ts'); import('../scripts/app.ts'); import('../scripts/texhover.ts'); }));
    // La couche d'animation (GSAP + Lenis) se charge quand le navigateur est libre :
    // le premier écran s'affiche sans l'attendre.
    const loadMotion = () => import('../scripts/motion.ts');
    if ('requestIdleCallback' in window) requestIdleCallback(loadMotion, { timeout: 1500 });
    else setTimeout(loadMotion, 300);
  </script>
</Base>
