---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/fonts.css';
import '../styles/global.css';
import Seo from '../components/seo/Seo.astro';
import { SITE } from '../config';
import archivoWoff from '../assets/fonts/archivo-lotivio-latin.woff2?url';
import geistWoff from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

// /essai (page de travail) n'est jamais indexée ; les autres pages Base le sont.
const noindex = Astro.url.pathname.startsWith('/essai');

// Page d'accueil : le produit et ses deux prix affichés (S09B, prix de Diego du 12.11.2026).
const app = {
  '@type': 'SoftwareApplication',
  name: 'Lotivio',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: SITE.description,
  url: SITE.url,
  inLanguage: 'fr-CH',
  areaServed: { '@type': 'Country', name: 'Suisse' },
  publisher: { '@id': `${SITE.url}/#org` },
  offers: [
    { '@type': 'Offer', name: 'Mise en place', price: '6500', priceCurrency: 'CHF', url: `${SITE.url}/#tarifs` },
    {
      '@type': 'Offer', name: 'Abonnement', url: `${SITE.url}/#tarifs`,
      priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: '450', priceCurrency: 'CHF', billingDuration: 'P1M', unitText: 'mois' },
    },
  ],
};
---
<!doctype html>
<html lang="fr-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" type="font/woff2" href={archivoWoff} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={geistWoff} crossorigin />
    <Seo ld={noindex ? [] : [app]} noindex={noindex} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <slot />
  </body>
</html>
