---
import Btn from './ui/Btn.astro';
import '../styles/s07-mise-en-place.css';
import '../styles/s07-scenes.css';
// Textes de Diego du 12.11.2026 (4 cartes). Version à 5 cartes : proofs/archive/S07MiseEnPlace-v1-5-cartes.astro
const tex = ['/media/tex/facade.svg', '/media/tex/chantier.svg', '/media/tex/quartier.svg'];

// Illustrations animées (bento) : chaque scène est jouée par src/scripts/bento.ts,
// qui pose les classes d'étape k1, k2… sur .il selon data-steps (ms) ; les mouvements sont
// des transitions CSS (global.css, « S07 · illustrations bento »). Sans JavaScript ou avec
// moins de mouvement, la scène s'affiche dans son état final. Données de démonstration.
const ico = {
  check: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.4l2.9 2.8 6-6.4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  cursor: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3l14 8.2-6.3 1.4 3.6 6.6-2.6 1.4-3.6-6.6L5 18.2z" fill="#141414" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/></svg>',
  mail: '<svg viewBox="0 0 20 20" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 6l6.5 5 6.5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
  globe: '<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M2.8 10h14.4M10 2.7c2.2 2.3 2.2 12.3 0 14.6M10 2.7c-2.2 2.3-2.2 12.3 0 14.6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>',
  arrow: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12L12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  sheet: '<svg viewBox="0 0 32 40" aria-hidden="true"><path d="M4 2h16l8 8v26a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" fill="#fff" stroke="#DCDAD4" stroke-width="1.5"/><path d="M20 2v8h8" fill="#F4F3F0" stroke="#DCDAD4" stroke-width="1.5" stroke-linejoin="round"/><path d="M7 18h18M7 23h18M7 28h18M14 15v17" stroke="#C9C6BF" stroke-width="1.3"/></svg>',
  pdf: '<svg viewBox="0 0 32 40" aria-hidden="true"><path d="M4 2h16l8 8v26a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" fill="#fff" stroke="#DCDAD4" stroke-width="1.5"/><rect x="5" y="22" width="22" height="10" rx="2" fill="#EB6E2C"/><text x="16" y="29.6" text-anchor="middle" font-size="7" font-family="ui-monospace,monospace" fill="#fff">PDF</text></svg>',
};

// S07.2 · carte des branchements (coordonnées de la tuile : 374 × 224, centre 187,124)
const hubL = [
  { y: 70, html: '<img src="/media/logos/homegate.svg" alt="" width="73" height="12" style="height:1.25em">' },
  { y: 124, html: '<img src="/media/logos/immoscout24.svg" alt="" width="33" height="20" style="height:2em">' },
  { y: 178, html: '<img src="/media/logos/immobilier-ch.svg" alt="" width="85" height="12" style="height:1.2em">' },
];
const hubR = [
  { y: 70, html: `<span class="il-i">${ico.globe}</span>Votre site`, dir: 'in' },
  { y: 124, html: '<img src="/media/logos/whatsapp.svg" alt="" width="18" height="18" style="height:1.8em">WhatsApp', dir: 'both' },
  { y: 178, html: `<span class="il-i">${ico.mail}</span>Outlook`, dir: 'out' },
];

// v3 (12.11.2026) : scènes enchaînées au niveau du parcours (src/scripts/s07.ts, styles s07-scenes.css).
// Portraits de démonstration existants (contacts du panneau 01, leads du panneau 02). Version précédente :
// proofs/archive/S07MiseEnPlace-v2-bento-etapes.astro (illustrations à étapes, bento.ts).
const P = (k: string) => `/media/${k[0] === 'c' ? 'contacts' : 'leads'}/${k}.webp`;
const lg = {
  hg: '<img src="/media/logos/homegate.svg" alt="" width="73" height="12" style="height:1.05em">',
  me: '<img src="/media/logos/meta-64.webp" alt="" width="68" height="14" style="height:1.15em">',
};
const atQ = [
  { q: 'D’où viennent vos demandes ?', a: [lg.hg, lg.me, `<span class="il-i">${ico.globe}</span>Votre site`] },
  { q: 'Qui répond aux nouvelles demandes ?', a: ['<b class="ia">SK</b>Sarah K. · Littoral'] },
  { q: 'Qui relance, et quand ?', a: ['<b class="ia o">DL</b>David L. · après 5 jours'] },
];
const cxLeads = [
  { img: P('l2'), name: 'Laura Girardin', from: 'Homegate', proj: 'Clos des Vergers', u: 1, out: 'mail' },
  { img: P('l1'), name: 'Thomas Rochat', from: 'Meta Ads', proj: 'Les Terrasses', u: 8, out: 'wa' },
  { img: P('l4'), name: 'Isabelle Monnier', from: 'ImmoScout24', proj: 'Les Terrasses', u: 2, out: 'mail' },
  { img: P('l3'), name: 'Pierre-Alain Droz', from: 'immobilier.ch', proj: 'Lac & Lumière', u: 3, out: 'mail' },
  { img: P('l5'), name: 'Lucas Berset', from: 'Votre site', proj: 'Clos des Vergers', u: 4, out: 'mail' },
];
const pmContacts = ['c1', 'c2', 'c3', 'c4', 'c5', 'c6'].map((k, i) => ({ img: P(k), name: ['Céline Favre', 'Marc Vuilleumier', 'Monique Matthey', 'Yann Renaud', 'Nadia Perret', 'Claude Jeanneret'][i] }));
const curveL = (y: number) => `M114 ${y}C146 ${y} 146 124 158 124`;
const curveR = (y: number) => `M260 ${y}C228 ${y} 228 124 216 124`;
---
<!-- S07 · Mise en place -->
<section class="hs" id="mise-en-place">
  <div class="hs-intro hs-intro-m" style="padding:0 var(--pad) 22px">
    <span class="eyb">🇨🇭 Pensé pour votre agence</span>
    <h2 data-flash>Votre équipe a des biens à vendre.<br />Nous préparons votre Lotivio.</h2>
    <p>De la reprise de vos contacts à la prise en main, nous installons Lotivio selon votre fonctionnement. Vous définissez vos besoins avec nous ; nous prenons en charge les connexions et les réglages.</p>
  </div>
  <div class="hs-pin">
    <div class="hs-track" id="hs-track">
      <div class="hs-intro" data-bloc="S07.0">
        <span class="eyb" data-scramble>🇨🇭 Pensé pour votre agence</span>
        <h2 data-flash>Votre équipe a des biens à vendre.<br />Nous préparons votre Lotivio.</h2>
        <p>De la reprise de vos contacts à la prise en main, nous installons Lotivio selon votre fonctionnement. Vous définissez vos besoins avec nous ; nous prenons en charge les connexions et les réglages.</p>
      </div>

      <!-- S07.1 · Atelier : la carte de fonctionnement de l'agence se dessine -->
      <article class="oc" data-bloc="S07.1"><pre class="tex ctex" data-src={tex[0]} data-w=".38" data-r=".95" aria-hidden="true"></pre>
        <span class="nb">1</span>
        <div class="ill" aria-hidden="true">
          <div class="s7 s7-at" data-s7="at" data-q={JSON.stringify(atQ)}>
            <div class="t t-map">
              <div class="t-h"><span class="lb">Votre fonctionnement</span><span class="live"><i></i>Atelier</span></div>
              <div class="map">
                <svg class="sv" viewBox="0 0 346 136">
                  <path class="dr d0" pathLength="1" d="M94 20C114 20 110 68 128 68" />
                  <path class="dr d1" pathLength="1" d="M94 68L128 68" />
                  <path class="dr d2" pathLength="1" d="M94 116C114 116 110 68 128 68" />
                  <path class="dr d3" pathLength="1" d="M218 68C234 68 228 36 244 36" />
                  <path class="dr d4" pathLength="1" d="M218 68C234 68 228 100 244 100" />
                  <path class="pu p0" pathLength="1" d="M94 20C114 20 110 68 128 68L218 68C234 68 228 36 244 36" />
                  <path class="pu p1" pathLength="1" d="M94 68L218 68C234 68 228 36 244 36" />
                  <path class="pu p2" pathLength="1" d="M94 116C114 116 110 68 128 68L218 68C234 68 228 100 244 100" />
                </svg>
                <span class="nd src n0" style="top:14.7%"><Fragment set:html={lg.hg} /></span>
                <span class="nd src n1" style="top:50%"><Fragment set:html={lg.me} /></span>
                <span class="nd src n2" style="top:85.3%"><span class="il-i"><Fragment set:html={ico.globe} /></span>Votre site</span>
                <span class="nd hub">Demande</span>
                <span class="nd ag n3" style="top:26.5%"><b class="ia">SK</b>répond<em class="ok"><Fragment set:html={ico.check} /></em></span>
                <span class="nd ag n4" style="top:73.5%"><b class="ia o">DL</b>relance<em class="ok"><Fragment set:html={ico.check} /></em></span>
              </div>
            </div>
            <div class="t dk t-q">
              <span class="lb">À l’atelier</span>
              <span class="qt">{atQ[2].q}</span>
              <div class="ans">{atQ.map((q, qi) => q.a.map((h) => <span data-q={qi} class={qi === 2 ? 'sh on' : undefined} set:html={h} />))}</div>
              <div class="qd"><i class="on"></i><i class="on"></i><i class="on"></i></div>
            </div>
            <div class="t t-team">
              <span class="lb">Votre équipe</span>
              <div class="mb on"><b class="ia">SK</b><span>Sarah K.<small>Répond</small></span></div>
              <div class="mb on"><b class="ia o">DL</b><span>David L.<small>Relance</small></span></div>
              <span class="role on"><em class="ok"><Fragment set:html={ico.check} /></em>Rôles définis</span>
            </div>
          </div>
        </div>
        <h3>Votre façon de travailler devient notre point de départ.</h3>
        <p>Nous regardons comment votre équipe reçoit, qualifie et relance ses contacts. Ensemble, nous identifions les tâches à simplifier et les étapes à automatiser pour concentrer la mise en place sur ce qui vous sera utile.</p>
      </article>

      <!-- S07.2 · Branchements : chaque canal se connecte, dans le bon sens -->
      <article class="oc" data-bloc="S07.2"><pre class="tex ctex" data-src={tex[1]} data-w=".38" data-r=".95" aria-hidden="true"></pre>
        <span class="nb">2</span>
        <div class="ill" aria-hidden="true">
          <div class="s7 s7-cx" data-s7="cx" data-leads={JSON.stringify(cxLeads)}>
            <div class="t t-hub">
              <div class="t-h"><span class="lb">Branchements</span><span class="live"><i></i>En direct</span></div>
              <div class="hubz">
                <svg class="sv" viewBox="0 0 374 224">
                  {hubL.map((n, i) => <path class={`dr d${i + 1}`} pathLength="1" d={curveL(n.y)} />)}
                  {hubR.map((n, i) => <path class={`dr d${i + 4}`} pathLength="1" d={curveR(n.y)} />)}
                  <path class="dr d7" pathLength="1" d="M187 62L187 96" />
                  <path class="dr d8" pathLength="1" d="M187 186L187 152" />
                  {hubL.map((n, i) => <path class={`pu u${i + 1}`} pathLength="1" d={curveL(n.y)} />)}
                  <path class="pu u4" pathLength="1" d={curveR(70)} />
                  <path class="pu u8" pathLength="1" d="M187 62L187 96" />
                  <path class="pu out uwa" pathLength="1" d="M216 124C228 124 228 124 260 124" />
                  <path class="pu out umail" pathLength="1" d="M216 124C228 124 228 178 260 178" />
                </svg>
                <span class="core"><img src="/brand/lotivio-mark.svg" alt="" width="34" height="34" /></span>
                {hubL.map((n, i) => <span class={`plg l n${i + 1}`} style={`top:${(n.y / 224) * 100}%`}><Fragment set:html={n.html} /><em class="ok"><Fragment set:html={ico.check} /></em></span>)}
                {hubR.map((n, i) => <span class={`plg r n${i + 4}`} style={`top:${(n.y / 224) * 100}%`}><Fragment set:html={n.html} /><em class="ok"><Fragment set:html={ico.check} /></em></span>)}
                <span class="plg c n7" style="top:23.2%"><img src="/media/logos/meta-64.webp" alt="" width="68" height="14" style="height:1.35em" /><em class="ok"><Fragment set:html={ico.check} /></em></span>
                <span class="plg c n8" style="top:89.3%"><img src="/media/logos/properstar-logo-84.webp" alt="" width="84" height="13" style="height:1.3em" /><em class="ok"><Fragment set:html={ico.check} /></em></span>
              </div>
            </div>
            <div class="t t-in">
              <div class="t-h"><span class="lb">Demandes reçues</span><b class="cnt">31</b></div>
              <div class="rl">
                {cxLeads.slice(0, 3).map((l) => <span class="rw"><img src={l.img} alt="" width="160" height="160" loading="lazy" decoding="async" /><span><b>{l.name}</b><small>{l.from} · {l.proj}</small></span></span>)}
              </div>
            </div>
            <div class="t dk t-out">
              <span class="lb">Envois</span>
              <div class="ot" data-o="mail"><span class="il-i"><Fragment set:html={ico.mail} /></span><span>E-mail via Outlook<small>Brochure · Laura Girardin</small></span><span class="go"><Fragment set:html={ico.arrow} /></span></div>
              <div class="ot" data-o="wa"><img src="/media/logos/whatsapp.svg" alt="" width="14" height="14" /><span>WhatsApp<small>Leads Meta Ads</small></span><span class="go"><Fragment set:html={ico.arrow} /></span></div>
            </div>
          </div>
        </div>
        <h3>Retrouvez vos contacts. Connectez vos canaux.</h3>
        <p>Nous importons votre base de contacts et configurons les connexions utiles à votre agence : portails, site, Meta Ads, WhatsApp professionnel et envoi d’e-mails. Vous retrouvez vos contacts existants et vos nouvelles demandes dans le même environnement.</p>
      </article>

      <!-- S07.3 · Parcours : l'agence choisit ce qui part seul et ce que l'agent valide -->
      <article class="oc" data-bloc="S07.3"><pre class="tex ctex" data-src={tex[2]} data-w=".38" data-r=".95" aria-hidden="true"></pre>
        <span class="nb">3</span>
        <div class="ill" aria-hidden="true">
          <div class="s7 s7-dl" data-s7="dl">
            <div class="t t-flow">
              <div class="t-h">
                <span class="who"><img src={P('l1')} alt="" width="160" height="160" loading="lazy" decoding="async" /><span><b>Thomas Rochat</b><small>Meta Ads · Les Terrasses</small></span></span>
                <span class="live"><i></i>Exemple</span>
              </div>
              <div class="stps">
                <span class="trk"><i></i></span>
                <div class="stp done" data-k="0"><i class="nd2"></i><span class="nme"><b>Premier contact</b><small><span class="a">En file</span><span class="b"><Fragment set:html={ico.check} />Envoyé</span></small></span><span class="tg on"><i></i><span>Auto</span></span></div>
                <div class="stp done" data-k="1"><i class="nd2"></i><span class="nme"><b>Brochure · WhatsApp</b><small><span class="a">En file</span><span class="b"><Fragment set:html={ico.check} />Envoyée</span></small></span><span class="tg on"><i></i><span>Auto</span></span></div>
                <div class="stp done ag" data-k="2"><i class="nd2"></i><span class="nme"><b>Relance · e-mail</b><small><span class="a">En file</span><span class="w">L’agent valide…</span><span class="b"><Fragment set:html={ico.check} />Validée, envoyée</span></small></span><span class="tg on"><i></i><span class="ta">Auto</span><span class="tb">Agent</span></span></div>
                <span class="cur"><Fragment set:html={ico.cursor} /></span>
              </div>
            </div>
            <div class="t t-wa">
              <span class="lb">WhatsApp</span>
              <div class="wa">
                <span class="doc"><Fragment set:html={ico.pdf} /></span>
                <span class="wb on"><span class="pd"><Fragment set:html={ico.pdf} /></span><span><b>Les Terrasses</b><small>brochure.pdf</small></span><em>21:48 ✓✓</em></span>
              </div>
            </div>
            <div class="t dk t-ok">
              <span class="lb">À valider</span>
              <div class="vr on"><b class="ia o">SK</b><span>Relance prête<small>Thomas Rochat</small></span></div>
              <span class="ln on"><i></i><i></i></span>
              <span class="btv ok2"><span class="a">Valider</span><span class="b"><Fragment set:html={ico.check} />Validée</span></span>
            </div>
          </div>
        </div>
        <h3>Déléguez des tâches. Gardez la main sur la relation.</h3>
        <p>Nous réglons les automatismes avec vous : ce qui peut partir seul, ce que l’agent valide et quand il intervient. Votre assistant IA s’appuie sur vos fiches projet, votre ton et vos consignes pour accompagner le suivi.</p>
      </article>

      <!-- S07.5 · Mise en route : import, équipe en ligne, première demande prise en charge -->
      <article class="oc" data-bloc="S07.5"><pre class="tex ctex" data-src={tex[1]} data-w=".38" data-r=".95" aria-hidden="true"></pre>
        <span class="nb">4</span>
        <div class="ill" aria-hidden="true">
          <div class="s7 s7-pm" data-s7="pm" data-contacts={JSON.stringify(pmContacts)}>
            <div class="t t-imp">
              <div class="t-h"><span class="lb">Import des contacts</span><span class="stx fin"><span class="a">En cours</span><span class="b"><Fragment set:html={ico.check} />Terminé</span></span></div>
              <div class="imp">
                <span class="file"><Fragment set:html={ico.sheet} /><small>contacts.csv</small><b class="n">1’248</b></span>
                <span class="flow"><i></i><i></i><i></i></span>
                <div class="cl">
                  {pmContacts.slice(0, 3).map((c) => <span class="cr"><img src={c.img} alt="" width="160" height="160" loading="lazy" decoding="async" /><b>{c.name}</b><em class="ok"><Fragment set:html={ico.check} /></em></span>)}
                </div>
              </div>
              <span class="pbar"><i style="--p:100%"></i></span>
            </div>
            <div class="t t-team5">
              <div class="t-h"><span class="lb">Équipe</span><span class="onl"><b>4</b>/4 en ligne</span></div>
              <div class="tm5">{['SK', 'DL', 'MR', 'AN'].map((x, k) => <span class={`av on v${k}`}><b>{x}</b><i></i></span>)}</div>
            </div>
            <div class="t dk t-new">
              <span class="lb">Nouvelle demande</span>
              <span class="nc on"><img src={P('l2')} alt="" width="160" height="160" loading="lazy" decoding="async" /><span><b>Laura Girardin</b><small>Homegate · Lot A2</small></span></span>
              <span class="take done"><span class="a">Prendre en charge</span><span class="b"><b class="ia o">DL</b>Pris en charge</span></span>
            </div>
          </div>
        </div>
        <h3>Prenez la main sur vos propres projets.</h3>
        <p>Votre équipe apprend à utiliser Lotivio avec ses biens et ses situations du quotidien. Traiter une demande, retrouver un acheteur, préparer une relance : nous vous accompagnons dans la prise en main pour que chacun sache comment l’utiliser.</p>
      </article>
    </div>
  </div>
  <div class="swipe" aria-hidden="true"><i><b></b><b></b><b></b></i>Faire glisser</div>
</section>
<script>
  import '../scripts/s07.ts';
</script>
<div class="par-end hs-end" data-bloc="S07.6"><Btn label="Parlons de votre mise en place" href="#demo" /></div>

